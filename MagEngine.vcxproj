<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{9C24208D-197B-4A5D-9A89-0997E9CF9A26}</ProjectGuid>
    <ProjectName>MagEngine</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="msbuild\EngineSettings.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <LocalDebuggerCommandArguments>--editor --project "$(ProjectDir)."</LocalDebuggerCommandArguments>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="engine\**\*.cpp;application\**\*.cpp;main.cpp" />
    <ClInclude Include="engine\**\*.h;application\**\*.h" />
  </ItemGroup>
  <!-- NOTE: ImGuiは別プロジェクトを作らず、外部ソースをそのまま利用する。 -->
  <ItemGroup>
    <ClCompile Include="externals\imgui\imgui.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
    <ClCompile Include="externals\imgui\imgui_demo.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
    <ClCompile Include="externals\imgui\imgui_draw.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
    <ClCompile Include="externals\imgui\imgui_tables.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
    <ClCompile Include="externals\imgui\imgui_widgets.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
    <ClCompile Include="externals\imgui\imgui_impl_dx12.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
    <ClCompile Include="externals\imgui\imgui_impl_win32.cpp"><TreatWarningAsError>false</TreatWarningAsError></ClCompile>
  </ItemGroup>
  <!-- NOTE: 外部依存はソリューションに追加せず、x64を明示してビルドする。 -->
  <PropertyGroup>
    <DirectXTexOutputDir>$(IntDir)DirectXTex\</DirectXTexOutputDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link><SubSystem>Windows</SubSystem>
      <AdditionalDependencies>$(DirectXTexOutputDir)DirectXTex.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="BuildDirectXTex" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="$(ProjectDir)externals\DirectXTex\DirectXTex_Desktop_2022_Win10.vcxproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64;SolutionDir=$(ProjectDir);OutDir=$(DirectXTexOutputDir);IntDir=$(DirectXTexOutputDir)obj\" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="msbuild\DeployRuntime.targets" />
</Project>
