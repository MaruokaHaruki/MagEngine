{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/MagEngine.sln",
                "/property:GenerateFullPaths=true",
                "/t:build", "/p:Platform=x64",
                "/p:Configuration=Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "buildRelease",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/MagEngine.sln",
                "/property:GenerateFullPaths=true",
                "/t:build", "/p:Platform=x64",
                "/p:Configuration=Release"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        }
    ]
}